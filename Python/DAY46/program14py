import numpy as np
import pandas as pd

def calculate_vif_numpy(X_mat):
    """
    Pure NumPy Function to calculate VIF for each feature.
    VIF_i = 1 / (1 - R_i^2)
    """
    n_features = X_mat.shape[1]
    vif_list = []
    
    for i in range(n_features):
        # Feature 'i' is target y, remaining features are predictor X
        y = X_mat[:, i]
        X = np.delete(X_mat, i, axis=1)
        
        # Add intercept column (ones)
        X = np.hstack([np.ones((X.shape[0], 1)), X])
        
        # Ordinary Least Squares (OLS): beta = (X^T X)^(-1) X^T y
        try:
            beta = np.linalg.lstsq(X, y, rcond=None)[0]
            y_pred = X @ beta
            
            # Calculate R-squared
            ss_tot = np.sum((y - np.mean(y)) ** 2)
            ss_res = np.sum((y - y_pred) ** 2)
            
            if ss_tot == 0 or ss_res < 1e-10: 
                # Perfect collinearity / Exact redundancy
                vif = np.inf
            else:
                r_squared = 1 - (ss_res / ss_tot)
                vif = 1 / (1 - r_squared)
        except np.linalg.LinAlgError:
            vif = np.inf
            
        vif_list.append(vif)
        
    return vif_list

# --- TESTING THE CODE ---
data = pd.DataFrame({
    "Experience":  [2, 4, 6, 8],
    "Projects":    [5, 8, 10, 12],
    "Performance": [70, 80, 90, 95],
    "Training":    [3, 5, 7, 9]  # Exact Redundant Column: Projects - Experience
})

X = data.values
rank = np.linalg.matrix_rank(X)
vifs = calculate_vif_numpy(X)

# Results Output
vif_df = pd.DataFrame({
    "Feature": data.columns,
    "VIF": vifs
})

print("=== FEATURE REDUNDANCY REPORT (PURE NUMPY) ===")
print(f"Matrix Rank : {rank} / {X.shape[1]}")
print(f"Status      : {'RANK DEFICIENT (Redundant Features Present) ❌' if rank < X.shape[1] else 'FULL RANK ✅'}\n")
print(vif_df)